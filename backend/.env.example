# COSMIC PREDICT backend configuration.
# Copy this file to backend/.env and fill in real values. Never commit secrets.

# --- Supabase (primary image/metadata store) ---
# Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role key (has write access; keep secret, never expose to the frontend).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket that holds raw FITS + parsed artifacts.
SUPABASE_BUCKET=spherex-images

# --- IRSA archive ---
# Verified SPHEREx SIA v2 endpoint used by the scraper/backend live provider.
SPHEREX_SIA_URL=https://irsa.ipac.caltech.edu/SIA?COLLECTION=spherex_qr2

# --- Optional ---
# Local fallback cache directory (used when Supabase is unreachable).
DATA_RAW_DIR=data/raw
# Trained JEPA checkpoint (optional; the app remains usable without one).
JEPA_CHECKPOINT=models/checkpoints/jepa.pt
