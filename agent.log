import json, math
o=json.load(open('data/explorations/ra76p9600_dec30p4000.json'))['candidates']
a=json.load(open('/tmp/analyze.json'))['candidates']
def ctr(x): return (x['row']+x['height']/2, x['column']+x['width']/2)
matched=0; pairs=[]
for oc in o:
    oy,ox=ctr(oc)
    best=None
    for sc in a:
        sy,sx=ctr(sc)
        dist=math.hypot(oy-sy,ox-sx)
        if best is None or dist<best[1]: best=(sc,dist)
    if best and best[1]<=6:
        matched+=1; pairs.append((oc['candidate_id'],best[0]['candidate_id'],round(best[1],1)))
print('OpenCV blobs with a scientific candidate within 6 px:',matched,'/',len(o))
print('scientific candidates recovered by OpenCV:',len({p[1] for p in pairs}),'/',len(a))
print('sample matches:',pairs[:12])
